{
  "packages": [
    "python@3.15.0",
    "python313Packages.jupyterlab@4.6.4",
    "python313Packages.bash-kernel@0.10.0",
    "jq@1.8.2",
    "vault-bin@1.21.4",
    "terraform@1.17.0",
    "openssl@3.6.4",
    "kind@0.33.0",
    "kubectl@1.37.1",
    "docker-client@28.5.1",
    "yq-go@4.54.1",
    "gnupg@2.4.9",
    "postgresql@17.10",
    "openldap@2.6.13",
  ],
  "shell": {
    "init_hook": [
      "mkdir -p /tmp/vault",
      "python -m bash_kernel.install --user",
    ],
    "scripts": {
      "start": [
        "jupyter lab --ip=0.0.0.0 --port=8888 --no-browser --allow-root --NotebookApp.token=''",
      ],
      "stop": [
        "pkill jupyter",
        "pkill -x vault",
      ],
    },
  },
}
